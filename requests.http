@host = http://localhost:3000

### Utwórz użytkownika
# @name create
POST {{host}}/users
Content-Type: application/json

{
  "firstName": "Jan",
  "lastName": "Nowakowski",
  "email": "email@example.com",
  "roleIds": [2],
  "password": "student123!@"
}

### uuid z odpowiedzi POST powyżej
@uuid = {{create.response.body.$.uuid}}

### Lista (domyślnie strona 1, limit 10)
GET {{host}}/users

### Stronicowanie
GET {{host}}/users?page=1&limit=2

### Strona poza zakresem (oczekiwane: data = [])
GET {{host}}/users?page=99&limit=10

### Jeden
GET {{host}}/user/{{uuid}}

### Zaktualizuj
PUT {{host}}/user/{{uuid}}
Content-Type: application/json

{
  "firstName": "Tomasz",
  "lastName": "Nowak",
  "email": "nowy@example.com"
}

### Usuń (oczekiwane 204)
DELETE {{host}}/user/{{uuid}}

### ---------------------------------------------------------
### Przypadki błędne
### ---------------------------------------------------------

### Zły format uuid (oczekiwane 400)
GET {{host}}/user/abc

### Poprawny uuid, którego nie ma (oczekiwane 404)
GET {{host}}/user/00000000-0000-4000-8000-000000000000

### Strona 0 (oczekiwane 400)
GET {{host}}/users?page=0

### Limit nie jest liczbą (oczekiwane 400)
GET {{host}}/users?limit=abc

### Limit ponad maksimum (oczekiwane 400)
GET {{host}}/users?limit=1000

### Brak emaila (oczekiwane 400)
POST {{host}}/users
Content-Type: application/json

{
  "firstName": "Jan",
  "lastName": "Nowakowski",
  "roleIds": [1],
  "password": "student123!@"
}

### Za krótkie hasło (oczekiwane 400)
POST {{host}}/users
Content-Type: application/json

{
  "firstName": "Jan",
  "lastName": "Nowakowski",
  "email": "email@example.com",
  "roleIds": [1],
  "password": "123"
}

### Brak roleIds (oczekiwane 400)
POST {{host}}/users
Content-Type: application/json

{
  "firstName": "Jan",
  "lastName": "Nowakowski",
  "email": "email@example.com",
  "password": "student123!@"
}

### Nieistniejąca rola (oczekiwane 400)
POST {{host}}/users
Content-Type: application/json

{
  "firstName": "Jan",
  "lastName": "Nowakowski",
  "email": "email@example.com",
  "roleIds": [1, 99],
  "password": "student123!@"
}